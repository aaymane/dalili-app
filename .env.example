# Copie ce fichier en `.env`. Sans clés Supabase, l'app tourne en MODE DÉMO (données locales).
#
# Supabase : le MÊME projet que le site (dalili.web), voir docs/SUPABASE.md.
# Dashboard Supabase → Project Settings → API → URL + clé publique (anon / publishable).
EXPO_PUBLIC_SUPABASE_URL=https://aiyyvgdrtaxvtedcuxnn.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Le site : guides, parcours, chiffres ET Dalili IA (/api/v1/assistant).
# Pour tester un site local depuis le simulateur : http://localhost:3100
EXPO_PUBLIC_SITE_URL=https://dalili.study

# Statistiques anonymes (PostHog, serveur européen, après accord de l'utilisateur). Facultatif : sans clé, rien n'est envoyé.
# PostHog → Project Settings → Project API key (commence par phc_, publique).
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# ⚠️ Ne mets JAMAIS ici la clé Anthropic ni la clé service Supabase :
# tout ce qui commence par EXPO_PUBLIC_ est visible dans l'app.
# Les clés de l'IA vivent uniquement côté serveur, dans Vercel (projet du site).
