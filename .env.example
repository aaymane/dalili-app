# Copie ce fichier en `.env` puis remplis avec les clés de ton projet Supabase
# (Dashboard Supabase → Project Settings → API).
# Sans ces clés, l'app tourne en MODE DÉMO (données locales).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# ⚠️ Ne mets JAMAIS ici la clé Anthropic ni la service_role key :
# tout ce qui commence par EXPO_PUBLIC_ est visible dans l'app.
# La clé Anthropic se configure côté serveur :
#   npx supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
