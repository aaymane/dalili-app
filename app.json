{
  "expo": {
    "name": "DALILI",
    "slug": "dalili",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dalili",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "study.dalili.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "study.dalili.app",
      "adaptiveIcon": {
        "backgroundColor": "#014DF8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": false,
          "supportedLocales": { "ios": ["fr", "ar", "en"], "android": ["fr", "ar", "en"] }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DALILI utilise tes photos pour ta photo de profil, tes publications et les documents que tu ranges dans ton coffre.",
          "cameraPermission": "DALILI utilise l’appareil photo pour scanner tes documents, ta photo de profil et tes appels vidéo avec un mentor.",
          "microphonePermission": "DALILI utilise le micro pendant tes appels avec un mentor."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B1233",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 96
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-secure-store",
        {
          "faceIDPermission": "DALILI utilise Face ID pour protéger l’accès à ton compte et à tes documents."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "DALILI utilise Face ID pour protéger l’accès à ton compte et à tes documents."
        }
      ],
      "./plugins/withDaily",
      [
        "react-native-document-scanner-plugin",
        {
          "cameraPermission": "DALILI utilise l’appareil photo pour scanner tes documents, ta photo de profil et tes appels vidéo avec un mentor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "3414c7f6-c3f4-4ac7-8929-81c769c8526c"
      }
    },
    "owner": "amriayman1"
  }
}
